{
  "name": "hypruse-browser",
  "version": "0.1.0",
  "private": true,
  "description": "A Chrome extension that lets local programs read and drive browser tabs through native messaging and hypruse.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && vite build --config vite.content.config.ts && node scripts/verify-extension-id.mjs",
    "icons": "node scripts/make-icons.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/chrome": "0.2.6",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "jsdom": "30.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
